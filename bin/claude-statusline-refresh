#!/usr/bin/env python3
"""claude-statusline-refresh [seconds=30]
Set statusLine.refreshInterval in ~/.claude/settings.json, so Claude Code redraws the status line
on a timer (the quota and countdown segments move even while the session is idle). Only touches a
status line it knows: `bash ~/.claude/statusline.sh` or amux's `amux-statusline`. Backs up to
settings.json.bak-refresh-<ts> first."""
import json, os, shutil, sys, time
if sys.argv[1:2] and sys.argv[1] in ("-h", "--help", "help"):
    print(__doc__.strip()); sys.exit(0)
try:
    n = int(sys.argv[1]) if len(sys.argv) > 1 else 30
except ValueError:
    sys.exit("usage: claude-statusline-refresh [seconds]   (-h for help)")
p = os.path.expanduser("~/.claude/settings.json")
if not os.path.exists(p):
    print("no settings.json"); sys.exit(0)
d = json.load(open(p))
sl = d.get("statusLine")
cmd = (sl or {}).get("command") or ""
if not sl or not (cmd == "bash ~/.claude/statusline.sh" or "amux-statusline" in cmd):
    print("statusLine not canonical, left alone: %s" % (sl or {}).get("command")); sys.exit(0)
if sl.get("refreshInterval") == n:
    print("already %d" % n); sys.exit(0)
shutil.copy2(p, p + ".bak-refresh-" + time.strftime("%Y%m%d-%H%M%S"))
sl["refreshInterval"] = n
tmp = p + ".tmp"
json.dump(d, open(tmp, "w"), indent=2, ensure_ascii=False); open(tmp, "a").write("\n")
json.load(open(tmp)); os.chmod(tmp, os.stat(p).st_mode & 0o777); os.replace(tmp, p)
print("refreshInterval -> %d" % n)
