has "starting it again in the same tmux session" "$o" && has "respawn-pane" "$(out_of sed -n '1,400p' "$TMUX_LOG")" && ! has "new-session" "$(out_of sed -n '1,400p' "$TMUX_LOG")" \
  && ok "amux start on a ~ session starts the agent again in the same pane" || bad "start on an open shell" "$o"
