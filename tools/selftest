#!/usr/bin/env bash
# selftest — prove this checkout works, without touching anything real.
#
# Everything runs against a THROWAWAY amux home and a throwaway bin directory, so
# it is safe to run on a machine that already has amux configured: it never reads,
# writes, or deletes your real ~/.amux, never contacts a real machine, and never
# starts or stops a session.
#
# What it proves:
#   1. every script parses (bash -n / py_compile)
#   2. every lib function a script calls is actually defined
#   3. install.sh installs, and the symlinked commands still find lib/
#   4. amux-config's whole lifecycle: add, show, test, rename, remove
#   5. security properties hold — secret-safe HTTP, validated names, exact tmux targets
#      and mode-600 config; remote exec/provider and numeric rename resolution work
#   6. the renderer produces the same output for local and remote given the same data
#   7. the bundled amux: version, help, models, server syntax, register/ls/account/rm on a
#      dummy session (never launched), completion generation
#   7b. the status line renders, sheds, and installs without clobbering settings
#   7c. amux search finds a project by content and ends with the --agentic tip;
#       -e ranks by co-occurrence, skips injected text, --show, groups, | head
#   7d. amux color: pin, hex, automatic, the tab sequence, the status line square
#   7e. sessions by name (amux search --sessions) against a fake second machine, and
#       the command-line fixes of 0.7.3: one row order everywhere, option checks,
#       re-register keeps a session, rename/rm/start-all, same-user dashboard access
#   7f. dashboard text cannot run as a command; cross-site requests are told apart;
#       pinned sessions, one codex resume rule, row numbers, a client-only install
#   7g. one rule for running / open shell / stopped in amux and in the server, the
#       three marks, one stop (ask, wait, end; --now), the same-user rule on macOS
#   7h. amux offload hands over to the offload tool; amux info --dir / --porcelain
#   7i. --partners: an opencode session gets OPENCODE_PARTNERS=1 only when asked for
#   8. the audit catches a planted secret
#
# Usage:
#   tools/selftest              run everything
#   tools/selftest -v           show each command's output
#
# Exit codes: 0 = all passed · 1 = something failed
set -uo pipefail

cd "$(dirname "$0")/.." || exit 1
REPO=$(pwd)

case "${1:-}" in
  -h|--help) awk 'NR==1&&/^#!/{next} /^[[:space:]]*#/{sub(/^[[:space:]]*#[[:space:]]?/,"");print;next} {exit}' "$0"; exit 0 ;;
esac
VERBOSE=0; [ "${1:-}" = "-v" ] && VERBOSE=1

RED=''; GREEN=''; DIM=''; BOLD=''; RESET=''
if [ -t 1 ]; then
  RED=$'\033[31m'; GREEN=$'\033[32m'; DIM=$'\033[2m'; BOLD=$'\033[1m'; RESET=$'\033[0m'
fi

PASS=0; FAIL=0
ok()   { PASS=$((PASS+1)); printf '  %s✓%s %s\n' "$GREEN" "$RESET" "$1"; }
bad()  { FAIL=$((FAIL+1)); printf '  %s✗%s %s\n' "$RED" "$RESET" "$1"; [ -n "${2:-}" ] && printf '      %s\n' "$2"; }
sect() { printf '\n%s%s%s\n' "$BOLD" "$1" "$RESET"; }

# Isolated sandbox. Everything the test writes lives here and is removed at exit.
SANDBOX=$(mktemp -d "${TMPDIR:-/tmp}/amux-selftest.XXXXXX")
cleanup() { rm -rf "$SANDBOX"; }
trap cleanup EXIT
# HOME itself moves into the sandbox, so nothing below can read or write your real
# ~/.amux, ~/.config or shell rc files — even a command that ignores CC_HOME.
# TMUX_TMPDIR does the same for tmux: any tmux call talks to a server that does
# not exist, never to the one running your sessions.
REAL_HOME="$HOME"
export HOME="$SANDBOX/home"
export CC_HOME="$HOME/.amux"
export BINDIR="$SANDBOX/bin"
export TMUX_TMPDIR="$SANDBOX/tmux"
export AMUX_NO_COMPLETION=1
unset TMUX CLAUDE_CODE_OAUTH_TOKEN CLAUDE_ACCOUNT
mkdir -p "$CC_HOME" "$BINDIR" "$TMUX_TMPDIR"

run() { if [ "$VERBOSE" = 1 ]; then "$@"; else "$@" >/dev/null 2>&1; fi; }

# Capture a command's output, then match against the captured STRING.
#
# Never `cmd | grep -q pat` in this file: grep -q exits at the first match, which
# SIGPIPEs the producer, and with `set -o pipefail` the pipeline then reports
# failure even though the match SUCCEEDED. That turns a passing check into a
# flaky failure whose flakiness depends on how much output the producer had
# already written — which is exactly how this suite first "failed" six real,
# working behaviors.
out_of()  { "$@" 2>&1; }
has()     { case "$2" in *"$1"*) return 0 ;; *) return 1 ;; esac; }
matches() { printf '%s' "$2" | grep -qE "$1"; }

# ── 1. syntax ────────────────────────────────────────────────────────────────
sect "1. Everything parses"
n=0; bad_files=""
for f in bin/* setup/* lib/*.sh tools/audit-clean tools/selftest install.sh; do
  [ -f "$f" ] || continue
  head -1 "$f" | grep -q 'python' && continue
  if bash -n "$f" 2>/dev/null; then n=$((n+1)); else bad_files="$bad_files $f"; fi
done
[ -z "$bad_files" ] && ok "$n shell scripts parse" || bad "shell syntax errors:$bad_files"

pyok=1
for f in lib/*.py bin/amux-server.py bin/amux-termprobe; do
  [ -f "$f" ] || continue
  python3 -c "import ast,sys; ast.parse(open(sys.argv[1],encoding='utf-8').read())" "$f" 2>/dev/null \
    || { bad "python syntax error in $f"; pyok=0; }
done
[ "$pyok" = 1 ] && ok "python files parse"

# ── 2. no undefined lib functions ────────────────────────────────────────────
sect "2. Every lib function used is defined"
defined=$(grep -ohE '^amux_[a-z_]+\(\)' lib/amux-common.sh | tr -d '()' | sort -u)
missing=""
# Only the shell scripts that source the lib (bin/amux-server.py carries
# unrelated amux_* names in its embedded web app).
for u in $(grep -l 'amux-common.sh' bin/* setup/* 2>/dev/null | xargs grep -hoE '\bamux_[a-z_]+\b' 2>/dev/null | sort -u); do
  printf '%s\n' "$defined" | grep -qx "$u" || missing="$missing $u"
done
[ -z "$missing" ] && ok "no undefined helpers" || bad "undefined lib functions:$missing"

# ── 3. install + symlink resolution ──────────────────────────────────────────
sect "3. install.sh works and symlinks resolve lib/"
if run ./install.sh; then
  ok "install.sh completed"
else
  bad "install.sh failed"
fi
count=$(ls "$BINDIR" 2>/dev/null | wc -l | tr -d ' ')
[ "$count" -ge 15 ] && ok "$count commands installed" || bad "only $count commands installed"

# The real risk with symlinks: a command that cannot find lib/ from its link.
export PATH="$BINDIR:$PATH"
if out=$(amux-config list 2>&1); then
  ok "symlinked command resolves lib/ (amux-config runs)"
else
  bad "symlinked command cannot find lib/" "$out"
fi

# Network-facing commands are mocked for the rest of the suite. The first pair
# simply fails fast for unreachable-path tests; section 5 replaces them with
# deterministic API/SSH fakes. No selftest operation contacts a real machine.
MOCK_HOME="$SANDBOX/mockhome"
MOCKBIN="$MOCK_HOME/.local/bin"
mkdir -p "$MOCKBIN"
cat > "$MOCKBIN/curl" <<'SH'
#!/usr/bin/env bash
printf '000'
exit 7
SH
cat > "$MOCKBIN/ssh" <<'SH'
#!/usr/bin/env bash
exit 255
SH
chmod +x "$MOCKBIN/curl" "$MOCKBIN/ssh"
export PATH="$MOCKBIN:$PATH"

# ── 4. amux-config lifecycle ─────────────────────────────────────────────────
sect "4. amux-config lifecycle"
FAKE_TOKEN="selftest-not-a-real-credential-0123456789"

printf '%s' "$FAKE_TOKEN" | run amux-config add testbox --host 192.0.2.77 --token-stdin
o=$(out_of amux-config list)
if has testbox "$o"; then
  ok "add + list"
else
  bad "add did not produce a listed box"
fi

envfile="$CC_HOME/remotes/testbox.env"
mode=$(ls -l "$envfile" 2>/dev/null | cut -c1-10)
[ "$mode" = "-rw-------" ] && ok "config file is mode 600" || bad "config file mode is $mode, expected -rw-------"

o=$(out_of amux-config show testbox)
if has 192.0.2.77 "$o"; then
  ok "show displays the URL"
else
  bad "show did not display the URL"
fi

# An unreachable box must read as UNREACHABLE, not as an unrecognized status.
o=$(out_of amux-config test testbox)
if matches "[Uu][Nn][Rr][Ee][Aa][Cc][Hh][Aa][Bb][Ll][Ee]" "$o"; then
  ok "unreachable box reported correctly"
else
  bad "unreachable box not reported as unreachable"
fi

run amux-config rename testbox renamedbox
o=$(out_of amux-config list)
if has renamedbox "$o"; then
  ok "rename"
else
  bad "rename failed"
fi

printf 'y\n' | run amux-config remove renamedbox
o=$(out_of amux-config list)
if ! has renamedbox "$o"; then
  ok "remove"
else
  bad "remove failed"
fi

# ── 4b. amux-up word order ───────────────────────────────────────────────────
# amux-up names the machine FIRST, mirroring `amux-remote <machine> <cmd>`. Both
# that and the older colon form must reach the remote lane, and a FLAG after the
# session name must never be mistaken for a machine name.
sect "4b. amux-up argument forms"
printf '%s' "$FAKE_TOKEN" | run amux-config add upbox --host 192.0.2.99 --token-stdin
# Bound each call: the remote lane ends in a real ssh to an unreachable
# documentation address, and we are only testing how arguments were parsed.
bounded() { perl -e 'alarm 6; exec @ARGV' "$@" 2>&1; }

o=$(bounded amux-up upbox somesession)
if has "on box 'upbox'" "$o"; then
  ok "amux-up <machine> <name> reaches the remote lane"
else
  bad "amux-up <machine> <name> did not reach the remote lane" "$o"
fi

o=$(bounded amux-up upbox:somesession)
if has "on box 'upbox'" "$o"; then
  ok "legacy amux-up <machine>:<name> still works"
else
  bad "legacy colon form broke" "$o"
fi

o=$(bounded amux-up notasession --continue)
if has "no box was named" "$o"; then
  ok "a flag after the name is not mistaken for a machine"
else
  bad "a flag was misread as a machine name" "$o"
fi
printf 'y\n' | run amux-config remove upbox

# ── 5. security properties ───────────────────────────────────────────────────
sect "5. Security properties"

# --token must be refused outright: argv is world-readable via ps.
o=$(out_of amux-config add x --host h --token "$FAKE_TOKEN")
if has "not supported on purpose" "$o"; then
  ok "--token is refused (keeps credentials off argv)"
else
  bad "--token was NOT refused"
fi

# No command may print a credential in full.
printf '%s' "$FAKE_TOKEN" | run amux-config add leaktest --host 192.0.2.78 --token-stdin
leaked=0
for cmd in "amux-config show leaktest" "amux-config list" "amux-config status"; do
  o=$($cmd 2>&1); if has "$FAKE_TOKEN" "$o"; then leaked=1; fi
done
[ "$leaked" = 0 ] && ok "no command prints a credential in full" || bad "a command printed the credential in full"

o=$(out_of amux-config show leaktest)
if matches "\\(41 chars\\)" "$o"; then
  ok "credential summarized as prefix + length"
else
  bad "credential summary missing or wrong"
fi
printf 'y\n' | run amux-config remove leaktest

# ── 5b. remote security + companion regressions ──────────────────────────────
sect "5b. Remote hardening and companion regressions"

# A deterministic curl stand-in records only non-secret argv, verifies that the
# authorization header arrived on stdin, and returns small API-shaped responses.
# If a token ever moves back onto argv, it records a marker instead of the value.
CURL_LOG="$SANDBOX/curl.argv"
SSH_LOG="$SANDBOX/ssh.argv"
TMUX_LOG="$SANDBOX/tmux.argv"
export AMUX_TEST_CURL_LOG="$CURL_LOG"
export AMUX_TEST_SSH_LOG="$SSH_LOG"
export AMUX_TEST_TMUX_LOG="$TMUX_LOG"
export AMUX_TEST_TOKEN="$FAKE_TOKEN"

cat > "$MOCKBIN/curl" <<'SH'
#!/usr/bin/env bash
set -u
method=GET
url=""
previous=""
header_stdin=0
header_file=""
for arg in "$@"; do
  case "$arg" in
    *"${AMUX_TEST_TOKEN:?}"*)
      printf 'TOKEN_ON_ARGV\n' >> "$AMUX_TEST_CURL_LOG"
      exit 97 ;;
  esac
  printf '%s\n' "$arg" >> "$AMUX_TEST_CURL_LOG"
  [ "$previous" = -X ] && method="$arg"
  [ "$arg" = @- ] && header_stdin=1
  case "$arg" in @/dev/fd/*|@/proc/*) header_file="${arg#@}" ;; esac
  case "$arg" in http://*|https://*) url="$arg" ;; esac
  previous="$arg"
done
if [ "$header_stdin" = 1 ] || [ -n "$header_file" ]; then
  if [ -n "$header_file" ]; then IFS= read -r header < "$header_file" || true
  else IFS= read -r header || true; fi
  case "$header" in
    *"$AMUX_TEST_TOKEN"*) ;;
    *"${AMUX_TEST_REAUTH_TOKEN:-unset-reauth-token}"*) ;;   # amux-reauth's own API probe
    *) printf 'HEADER_MISSING\n' >> "$AMUX_TEST_CURL_LOG"; exit 98 ;;
  esac
fi
case "$url" in
  https://api.anthropic.com/*) printf '200' ;;
  */api/sessions/*/peek*)      printf '{"output":"peek-ok"}' ;;
  */api/sessions/*/send*)      printf '{"ok":true}' ;;
  */api/sessions/*/info*)      printf '{"provider":"codex","state":"agent","running":true}' ;;
  */api/sessions/*/config)     printf '{"ok":true,"message":"configuration updated"}' ;;
  */api/sessions/*/start)      printf '{"ok":true,"message":"started"}' ;;
  */api/sessions)
    if [ "$method" = POST ]; then printf '{"ok":true,"message":"created"}'
    else printf '[]'
    fi ;;
  *) printf '{}' ;;
esac
SH
cat > "$MOCKBIN/ssh" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" > "${AMUX_TEST_SSH_LOG:?}"
exit 0
SH
cat > "$MOCKBIN/tmux" <<'SH'
#!/usr/bin/env bash
printf '%s\n' "$@" >> "${AMUX_TEST_TMUX_LOG:?}"
case "${1:-}" in has-session) exit 1 ;; esac
exit 0
SH
cat > "$MOCKBIN/amux" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat > "$MOCKBIN/claude" <<'SH'
#!/usr/bin/env bash
exit 0
SH
cat > "$MOCKBIN/security" <<'SH'
#!/usr/bin/env bash
exit 1
SH
cat > "$MOCKBIN/pgrep" <<'SH'
#!/usr/bin/env bash
printf '4242\n'
SH
cat > "$MOCKBIN/lsof" <<'SH'
#!/usr/bin/env bash
printf 'n%s\n' "${AMUX_TEST_CC_DIR:?}"
SH
cat > "$MOCKBIN/ps" <<'SH'
#!/usr/bin/env bash
printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "${AMUX_TEST_REAUTH_TOKEN:?}"
SH
chmod +x "$MOCKBIN"/*

printf '%s' "$FAKE_TOKEN" \
  | run amux-config add remotebox --host 192.0.2.79 --ssh-host example-host --token-stdin

: > "$CURL_LOG"
o=$(out_of amux-remote remotebox peek safe.name 7)
curl_args=$(out_of sed -n '1,200p' "$CURL_LOG")
if has "peek-ok" "$o" && has "/api/sessions/safe.name/peek?lines=7" "$curl_args" \
   && ! has "TOKEN_ON_ARGV" "$curl_args"; then
  ok "remote REST path is encoded and the token stays off curl argv"
else
  bad "remote peek security regression" "$curl_args"
fi

: > "$CURL_LOG"
o=$(out_of amux-remote remotebox peek 'bad/name' 7)
curl_args=$(out_of sed -n '1,20p' "$CURL_LOG")
if has "invalid session name" "$o" && [ -z "$curl_args" ]; then
  ok "invalid session paths are rejected before curl"
else
  bad "invalid REST session name reached curl"
fi

rm -f "$SSH_LOG"
o=$(out_of amux-remote remotebox attach "bad'name" --plain)
if has "invalid session name" "$o" && [ ! -e "$SSH_LOG" ]; then
  ok "attach rejects shell metacharacters before ssh"
else
  bad "attach name validation failed"
fi

run amux-remote remotebox attach safe.name --plain
ssh_args=$(out_of sed -n '1,20p' "$SSH_LOG")
if has "-t '=amux-safe.name'" "$ssh_args"; then
  ok "attach uses an exact tmux target"
else
  bad "attach did not use an exact tmux target" "$ssh_args"
fi

o=$(out_of amux-remote remotebox exec new-session --dir '~/project' --model model-test --provider codex)
curl_args=$(out_of sed -n '1,200p' "$CURL_LOG")
if has "created new-session" "$o" && has '"provider": "codex"' "$curl_args" \
   && has '"model": "model-test"' "$curl_args" \
   && has "/api/sessions/new-session/start" "$curl_args"; then
  ok "remote exec creates, configures provider/model, and starts"
else
  bad "remote exec/provider flow failed" "$curl_args"
fi

o=$(out_of amux-remote remotebox provider safe.name)
if has "codex" "$o"; then
  ok "remote provider query works"
else
  bad "remote provider query failed" "$o"
fi

# start must forward extra args as one-shot flags in the JSON body — including
# values with spaces — and print the attach next-step hint (start != attach).
: > "$CURL_LOG"
o=$(out_of amux-remote remotebox start safe.name --append-system-prompt 'say hi')
curl_args=$(out_of sed -n '1,200p' "$CURL_LOG")
if has "/api/sessions/safe.name/start" "$curl_args" \
   && has "--append-system-prompt 'say hi'" "$curl_args" \
   && has "attach: amux-remote remotebox attach safe.name" "$o"; then
  ok "remote start forwards one-shot flags (spaces survive) and hints the attach"
else
  bad "remote start flag forwarding failed" "$curl_args"
fi

# Zero-flag start must stay byte-identical: no JSON body at all.
: > "$CURL_LOG"
o=$(out_of amux-remote remotebox start safe.name)
curl_args=$(out_of sed -n '1,200p' "$CURL_LOG")
if has "/api/sessions/safe.name/start" "$curl_args" && ! has '"flags"' "$curl_args"; then
  ok "zero-flag start sends no body"
else
  bad "zero-flag start grew a body" "$curl_args"
fi

# The hint is suppressed for wrappers that attach right after (amux-up).
o=$(out_of env AMUX_NO_HINT=1 amux-remote remotebox start safe.name)
if ! has "attach: amux-up" "$o"; then
  ok "AMUX_NO_HINT suppresses the attach hint"
else
  bad "attach hint printed despite AMUX_NO_HINT" "$o"
fi

# stop takes one session (and --now) — unexpected extras must die loudly BEFORE any
# request, not be silently ignored.
: > "$CURL_LOG"
o=$(out_of amux-remote remotebox stop safe.name extra-arg)
curl_args=$(out_of sed -n '1,20p' "$CURL_LOG")
if has "unexpected argument 'extra-arg'" "$o" && [ -z "$curl_args" ]; then
  ok "stop rejects unexpected extra args before any request"
else
  bad "stop swallowed extra args" "$o"
fi

# amux-up two-word form: the machine interpretation wins, launch flags ride the
# start request (not the attach), and --plain routes to attach only.
rm -f "$SSH_LOG"; : > "$CURL_LOG"
o=$(out_of amux-up remotebox safe.name --continue --plain)
curl_args=$(out_of sed -n '1,200p' "$CURL_LOG")
ssh_args=$(out_of sed -n '1,20p' "$SSH_LOG")
if has '"flags": "--continue"' "$curl_args" \
   && has "-t '=amux-safe.name'" "$ssh_args" \
   && ! has "attach: amux-up" "$o" \
   && ! has "continue" "$ssh_args"; then
  ok "amux-up <machine> <name> starts with flags then attaches (flags routed)"
else
  bad "amux-up flag routing failed" "curl: $curl_args | ssh: $ssh_args"
fi

# Globs put 2fa first and alpha second. Query "2" must resolve row 2 (alpha),
# not the unique prefix 2fa.
mkdir -p "$CC_HOME/sessions"
: > "$CC_HOME/sessions/2fa.env"
: > "$CC_HOME/sessions/alpha.env"
: > "$CC_HOME/sessions/beta.env"
o=$(out_of amux-rename -n 2 renamed)
if has "alpha" "$o" && ! has "2fa" "$o"; then
  ok "numeric rename lookup wins over prefix matching"
else
  bad "numeric rename lookup selected the wrong session" "$o"
fi

# Exercise reauth without touching a real credential store or process table.
REAUTH_ENV="$SANDBOX/reauth.env"
AMUX_TEST_CC_DIR="$SANDBOX/project"
AMUX_TEST_REAUTH_TOKEN="sk-ant-oat$(printf '%s' 'selftest-only-value')"
export AMUX_TEST_CC_DIR AMUX_TEST_REAUTH_TOKEN
printf 'CLAUDE_CODE_OAUTH_TOKEN=%s\n' "$AMUX_TEST_REAUTH_TOKEN" > "$REAUTH_ENV"
printf 'CC_DIR="%s"\n' "$AMUX_TEST_CC_DIR" > "$CC_HOME/sessions/api.env"
: > "$TMUX_LOG"
o=$(AMUX_REAUTH_HOME="$MOCK_HOME" AMUX_REAUTH_ENVFILE="$REAUTH_ENV" AMUX_REAUTH_CLAUDE=claude \
  amux-reauth -d api 2>&1)
tmux_args=$(out_of sed -n '1,80p' "$TMUX_LOG")
if has "=amux-api" "$tmux_args" && has "durable token verified" "$o"; then
  ok "reauth waits on an exact tmux target"
else
  bad "reauth exact-target regression" "out: $o | tmux: $tmux_args"
fi

printf 'y\n' | run amux-config remove remotebox

# ── 6. renderer parity ───────────────────────────────────────────────────────
sect "6. amux-ls draws rows the way amux ls numbers them"
FIX='[{"name":"alpha","running":true,"active_model":"claude-opus-5","dir":"/home/u/a","archived":false},
     {"name":"beta","running":false,"active_model":"claude-sonnet-5","dir":"/home/u/b","archived":false}]'
loc=$(printf '%s' "$FIX" | AMUX_LS_LABEL=host AMUX_LS_KIND=local  AMUX_LS_COMPACT=1 AMUX_LS_BARE=1 python3 lib/amux-render.py 2>&1)
rem=$(printf '%s' "$FIX" | AMUX_LS_LABEL=host AMUX_LS_KIND=remote AMUX_LS_COMPACT=1 AMUX_LS_BARE=1 python3 lib/amux-render.py 2>&1)
if [ "$loc" = "$rem" ] && [ -n "$loc" ]; then
  ok "identical data renders identically local vs remote"
else
  bad "local and remote renders differ" "local=[$loc] remote=[$rem]"
fi
ORD='[{"name":"beta","provider":"codex"},{"name":"Zed","provider":"claude","account":"team"},{"name":"x-y"},{"name":"x"},{"name":"alpha","archived":true}]'
o=$(printf '%s' "$ORD" | AMUX_LS_BARE=1 AMUX_LS_COMPACT=1 COLUMNS=200 python3 lib/amux-render.py 2>&1 | tr -s ' ')
if has "2 ○ cx:beta 3 ○ P:cc:x 4 ○ P:cc:x-y 5 ○ T:cc:Zed" "$o"; then
  ok "rows are sorted and tagged like amux ls; a hidden archived row keeps its number"
else
  bad "amux-ls row order / tags / numbers" "$o"
fi

o=$(printf '%s' "$FIX" | AMUX_LS_BARE=1 AMUX_LS_COMPACT=1 AMUX_LS_ASCII=1 python3 lib/amux-render.py 2>&1)
if has "*" "$o"; then
  ok "ASCII mode renders ASCII marks (Windows consoles)"
else
  bad "ASCII mode did not produce ASCII marks"
fi

# Archived sessions hidden by default, shown on request.
ARCH='[{"name":"old","running":false,"archived":true},{"name":"new","running":false,"archived":false}]'
vis=$(printf '%s' "$ARCH" | AMUX_LS_BARE=1 AMUX_LS_COMPACT=1 python3 lib/amux-render.py 2>/dev/null)
if has new "$vis" && ! has old "$vis"; then
  ok "archived sessions hidden by default"
else
  bad "archived filtering wrong"
fi

# ── 7. the bundled amux ──────────────────────────────────────────────────────
# Uses the INSTALLED copy in $BINDIR (so install.sh is part of what is tested),
# with HOME and TMUX_TMPDIR in the sandbox. Nothing is ever started: register
# writes config only, and the tmux on PATH is the logging mock from 5b.
sect "7. Bundled amux (dummy session, never launched)"
want=$(sed -n 's/^CC_VERSION="\(.*\)"$/\1/p' bin/amux | head -1)
o=$(out_of "$BINDIR/amux" --version)
if has "amux v$want" "$o"; then ok "installed amux reports v$want"; else bad "amux --version" "$o"; fi
rel=$(tr -d ' \n' < VERSION)
if has "amux-nui-public release $rel" "$o" && has "**Version $rel**" "$(sed -n '1,12p' README.md)" \
   && has "## $rel " "$(sed -n '1,8p' CHANGELOG.md)"; then
  ok "amux version, VERSION, README and CHANGELOG agree on release $rel"
else
  bad "release number differs between amux version, VERSION, README or CHANGELOG" "$o"
fi

o=$(out_of "$BINDIR/amux" --help)
if has "Accounts" "$o" || has "--account" "$o"; then ok "amux --help renders"; else bad "amux --help" "$(printf '%s' "$o" | head -5)"; fi

o=$(out_of "$BINDIR/amux" models claude)
if has "alias: newest Fable" "$o" && has "claude-fable-5-2" "$o"; then ok "amux models lists the fable alias and Fable 5.2"; else bad "amux models claude" "$(printf '%s' "$o" | head -8)"; fi

if cmp -s bin/amux-server.py "$BINDIR/amux-server.py"; then
  ok "amux-server.py installed as a copy beside amux"
else
  bad "amux-server.py missing or different in $BINDIR"
fi
o=$(out_of python3 "$BINDIR/amux-server.py" --help)
if has "--bind" "$o"; then ok "amux-server.py --help runs"; else bad "amux-server.py --help" "$(printf '%s' "$o" | tail -3)"; fi

mkdir -p "$SANDBOX/proj"
o=$(out_of "$BINDIR/amux" register demo --provider claude --dir "$SANDBOX/proj")
if [ -f "$CC_HOME/sessions/demo.env" ]; then ok "register writes a session config"; else bad "register failed" "$o"; fi
o=$(out_of "$BINDIR/amux" ls)
if has "demo" "$o"; then ok "amux ls lists the dummy session"; else bad "amux ls" "$o"; fi
if has "P:cc:" "$o"; then ok "ls prefixes account + provider (P:cc:)"; else bad "ls prefix missing" "$o"; fi

o=$(out_of "$BINDIR/amux" account demo team)
if has "not set up" "$o" && ! grep -q 'CC_ACCOUNT=.*team' "$CC_HOME/sessions/demo.env"; then
  ok "a missing team slot is refused, not silently ignored"
else
  bad "account change without a slot was not refused" "$o"
fi
mkdir -p "$HOME/.config/claude-code"
( umask 077; printf 'export CLAUDE_ACCOUNT=team\n' > "$HOME/.config/claude-code/env.team" )
o=$(out_of "$BINDIR/amux" account demo T)
if grep -q 'team' "$CC_HOME/sessions/demo.env"; then ok "account change stored once the slot exists (T = team)"; else bad "account change" "$o"; fi
o=$(out_of "$BINDIR/amux" ls)
if has "T:cc:" "$o"; then ok "ls shows the new account (T:cc:)"; else bad "ls after account change" "$o"; fi

# lib/ccacct.sh: switching sources the slot and never prints its contents.
o=$(bash -c '. lib/ccacct.sh; ccacct team; printf "acct=%s\n" "$CLAUDE_ACCOUNT"' 2>&1)
if has "acct=team" "$o"; then ok "ccacct switches the terminal to a slot"; else bad "ccacct" "$o"; fi
o=$(bash -c '. lib/ccacct.sh; ccacct team2' 2>&1)
if has "no team2 slot" "$o"; then ok "ccacct refuses a missing slot"; else bad "ccacct missing slot" "$o"; fi

o=$(out_of "$BINDIR/amux" completion zsh)
if has "compdef" "$o"; then ok "zsh completion generates"; else bad "zsh completion" "$(printf '%s' "$o" | head -3)"; fi

printf 'y\n' | run "$BINDIR/amux" rm demo
[ ! -f "$CC_HOME/sessions/demo.env" ] && ok "rm removes the dummy session" || bad "rm left the session behind"

# ── 7b. status line ──────────────────────────────────────────────────────────
sect "7b. Status line"
SL="$BINDIR/amux-statusline"
_now=$(date +%s)
SLJSON='{"model":{"id":"claude-opus-5-5","display_name":"Opus 5.5"},"effort":{"level":"high"},"workspace":{"current_dir":"'"$SANDBOX"'","project_dir":"'"$SANDBOX"'"},"context_window":{"remaining_percentage":82,"total_input_tokens":36000,"total_output_tokens":2000},"rate_limits":{"five_hour":{"used_percentage":61,"resets_at":'$((_now+12000))'},"seven_day":{"used_percentage":75,"resets_at":'$((_now+200000))'}},"session_id":"selftest-sl","version":"0.0.1"}'
plain() { sed 's/\x1b\[[0-9;]*m//g'; }
o=$(printf '%s' "$SLJSON" | COLUMNS=200 "$SL" 2>&1 | plain)
if has "Op5⁵ hi" "$o" && has "ctx 82%" "$o" && has "in 36k" "$o" && has "7d 75%" "$o" && has "5h 61%" "$o"; then
  ok "renders model, context, tokens and both quotas"
else
  bad "status line render" "$o"
fi
o=$(printf '%s' "$SLJSON" | COLUMNS=70 "$SL" 2>&1 | plain)
if has "ctx 82%" "$o" && ! has "Σ" "$o"; then ok "narrow pane sheds Σ and keeps ctx"; else bad "narrow shedding" "$o"; fi
# tab title: a stand-in tmux reports the window name and records what it is renamed to
mkdir -p "$SANDBOX/stubbin"
printf '%s\n' '#!/bin/sh' 'case "$1" in display-message) cat "$SL_TITLE.name" ;; rename-window) for a; do :; done; printf "%s" "$a" > "$SL_TITLE" ;; esac' > "$SANDBOX/stubbin/tmux"
chmod +x "$SANDBOX/stubbin/tmux"
sl_title() { rm -f "$SANDBOX/title.txt"; printf '%s\n' "${2-demo}" > "$SANDBOX/title.txt.name"; printf '%s' "$SLJSON" | env -u AMUX_NAME SL_TITLE="$SANDBOX/title.txt" TMUX=stub TMUX_PANE=%0 PATH="$SANDBOX/stubbin:$PATH" COLUMNS="$1" "$SL" >/dev/null 2>&1; cat "$SANDBOX/title.txt" 2>/dev/null; }
o=$(sl_title 200)
if has "demo@" "$o" && has "(O hi)" "$o"; then ok "a wide window is titled name@machine (model effort)"; else bad "wide tab title" "$o"; fi
o=$(sl_title 89 "demo@box (O hi)")
[ "$o" = "demo" ] && ok "a narrow window is titled with the session name alone" || bad "narrow tab title" "$o"
mkdir -p "$HOME/.config/amux"; printf 'title-wide 80\n' > "$HOME/.config/amux/statusline.conf"
o=$(sl_title 89)
has "demo@" "$o" && ok "title-wide moves the cut-off" || bad "title-wide ignored" "$o"
rm -f "$HOME/.config/amux/statusline.conf"
n=$(awk '/^exec python3 -c /{on=1;next} on' "$REPO/bin/amux-statusline" | tr -cd "'" | wc -c | tr -d ' ')
[ "$n" = 1 ] && ok "python body has no stray apostrophe" || bad "python body has $((n-1)) stray apostrophe(s)"
printf '%s' "$SLJSON" | COLUMNS=200 "$SL" >/dev/null 2>&1
[ ! -e "$HOME/.claude/quota.log" ] && ok "quota log is off by default" || bad "quota log written without opt-in"
mkdir -p "$HOME/.config/amux"
printf 'color %s 99\nquota-log on\n' "$(uname -n | cut -c1-3)" > "$HOME/.config/amux/statusline.conf"
o=$(printf '%s' "$SLJSON" | COLUMNS=200 "$SL" 2>&1)
has "38;5;99m" "$o" && ok "config fixes the machine color" || bad "config color ignored"
[ -s "$HOME/.claude/quota.log" ] && ok "quota-log on writes the log" || bad "quota-log on wrote nothing"
rm -f "$HOME/.config/amux/statusline.conf" "$HOME/.claude/quota.log"
o=$("$SL" --install 2>&1)
if python3 -c 'import json,os,sys; c=json.load(open(os.path.expanduser("~/.claude/settings.json")))["statusLine"]["command"]; sys.exit(0 if c.endswith("/amux-statusline") else 1)' 2>/dev/null; then
  ok "--install wires settings.json"
else
  bad "--install did not wire settings.json" "$o"
fi
has "already installed" "$("$SL" --install 2>&1)" && ok "--install is idempotent" || bad "--install not idempotent"
"$SL" --uninstall >/dev/null 2>&1
printf '{"statusLine":{"type":"command","command":"my-own-line"},"keep":1}\n' > "$HOME/.claude/settings.json"
if ! "$SL" --install >/dev/null 2>&1 && grep -q my-own-line "$HOME/.claude/settings.json"; then
  ok "--install refuses to replace an existing status line"
else
  bad "--install replaced someone else's status line"
fi
"$SL" --uninstall >/dev/null 2>&1
grep -q my-own-line "$HOME/.claude/settings.json" && ok "--uninstall leaves a foreign status line alone" || bad "--uninstall removed a foreign status line"
rm -rf "$HOME/.claude"

# ── 7c. amux search ──────────────────────────────────────────────────────────
sect "7c. amux search"
# amux search greps with ripgrep, and where there is no rg it runs Claude Code's own
# binary as one. The stand-in `claude` from section 5b must not be taken for it
# (on a machine without rg every file search here then found nothing).
rm -f "$MOCKBIN/claude"
mkdir -p "$HOME/claudecode/searchproj"
printf 'notes about zebrafinch42\n' > "$HOME/claudecode/searchproj/notes.txt"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux" search zebrafinch42 2>&1 | plain)
has "searchproj" "$o" && ok "finds a session-less project dir by file content" || bad "amux search missed the project dir" "$o"
if has "amux search --agentic 'which sessions worked on zebrafinch42, and what did they do?'" "$o"; then
  ok "ends with a one-line --agentic tip built from the search"
else
  bad "no --agentic tip" "$o"
fi
o=$(PATH="$BINDIR:$PATH" "$BINDIR/amux" search "how did we fix zebrafinch42" 2>&1 | plain)
has "amux search --agentic 'how did we fix zebrafinch42'" "$o" && ok "a question is suggested as typed, not wrapped again" || bad "question re-wrapped" "$o"
o=$(AMUX_SEARCH_INNER=1 PATH="$BINDIR:$PATH" "$BINDIR/amux" search zebrafinch42 2>&1)
! has "tip:" "$o" && ok "no tip when the agentic run's own agent reads it" || bad "tip shown to the agent"
# a Claude transcript: one real mention of both words, plus words that live only in an
# injected reminder (must not count)
key=$(python3 -c 'import os,re,sys; print(re.sub(r"[^A-Za-z0-9]", "-", os.path.realpath(sys.argv[1])))' "$HOME/claudecode/searchproj")
mkdir -p "$HOME/.claude/projects/$key"
{
  printf '%s\n' '{"type":"user","timestamp":"2026-10-01T10:00:00Z","message":{"role":"user","content":"set up wombat99 with quokka77 please"}}'
  printf '%s\n' '{"type":"user","timestamp":"2026-10-01T10:01:00Z","message":{"role":"user","content":[{"type":"text","text":"<system-reminder>numbat55 rules</system-reminder> ok"}]}}'
} > "$HOME/.claude/projects/$key/0000aaaa-test.jsonl"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux" search -e wombat99 -e quokka77 2>&1 | plain)
has "wombat99×1 quokka77×1 · all in 1" "$o" && ok "-e terms are counted together (co-occurrence)" || bad "-e co-occurrence line missing" "$o"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux" search --in chat numbat55 2>&1 | plain)
has "no matches" "$o" && ok "text inside an injected reminder is not a match" || bad "injected reminder text matched" "$o"
[ -d "$HOME/.amux/cache/search" ] && ok "the said-text cache was built" || bad "no ~/.amux/cache/search"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux-search" --show "$HOME/claudecode/searchproj" -e quokka77 2>&1 | plain)
has "set up wombat99 with quokka77" "$o" && ok "--show prints the session's prompts and excerpts" || bad "--show output missing" "$o"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux" search --corefleet zebrafinch42 2>&1 | plain)
has "no CORE group defined" "$o" && has "searchproj" "$o" && ok "--corefleet without groups searches this machine" || bad "--corefleet without groups" "$o"
printf 'CORE="local"\n' > "$HOME/.amux/search-groups.conf"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux" search --corefleet zebrafinch42 2>&1 | plain)
! has "no CORE group" "$o" && has "searchproj" "$o" && ok "--corefleet reads ~/.amux/search-groups.conf" || bad "--corefleet with a group file" "$o"
rm -f "$HOME/.amux/search-groups.conf"
o=$(cd "$SANDBOX" && PATH="$BINDIR:$PATH" "$BINDIR/amux-search" zebrafinch42 2>&1 | head -1; echo "rc=${PIPESTATUS[0]}")
! has "BrokenPipe" "$o" && ! has "rc=120" "$o" && ok "piping into head ends quietly" || bad "| head raised" "$o"
rm -rf "$HOME/claudecode" "$HOME/.claude" "$HOME/.amux/cache"

# ── 7d. amux color ───────────────────────────────────────────────────────────
sect "7d. amux color"
mkdir -p "$SANDBOX/cproj"
run "$BINDIR/amux" register cone --provider claude --dir "$SANDBOX/cproj" --color teal
run "$BINDIR/amux" register ctwo --provider claude --dir "$SANDBOX/cproj"
o=$(PATH="$BINDIR:$PATH" "$BINDIR/amux" color cone 2>&1 | plain)
has "teal (pinned)" "$o" && ok "register --color pins the color" || bad "register --color did not pin" "$o"
! grep -q -- "--color" "$CC_HOME/sessions/cone.env" && ok "--color is not stored as an agent flag" || bad "--color leaked into the session flags"
o=$(PATH="$BINDIR:$PATH" "$BINDIR/amux" color ctwo '#ff8800' 2>&1 | plain)
has "#ff8800 (pinned)" "$o" && ok "a #rrggbb color can be pinned" || bad "hex pin failed" "$o"
PATH="$BINDIR:$PATH" "$BINDIR/amux" color ctwo auto >/dev/null 2>&1
"$BINDIR/amux-color" ensure cone; "$BINDIR/amux-color" ensure ctwo
a=$("$BINDIR/amux-color" get cone); b=$("$BINDIR/amux-color" get ctwo)
[ -n "$b" ] && [ "${a%% *}" != "${b%% *}" ] && ok "an automatic color differs from the pinned one" || bad "automatic color clashed" "$a / $b"
o=$("$BINDIR/amux-color" osc cone | od -c | head -1)
has "] 6 ; 1 ; b g ; r e d" "$(printf '%s' "$o" | tr -s ' ')" && ok "the tab sequence is produced" || bad "no tab sequence" "$o"
o=$(python3 -c 'import importlib.machinery as m, importlib.util as u, os, sys
l = m.SourceFileLoader("ac", sys.argv[1]); s = u.spec_from_loader("ac", l); c = u.module_from_spec(s); l.exec_module(c)
print(c.mosh_relay(os.getpid(), c.osc(None)), c._ssh_alias_for("192.0.2.77"))' "$BINDIR/amux-color" 2>&1)
[ "$o" = "False 192.0.2.77" ] && ok "the mosh relay stays idle outside mosh" || bad "mosh relay misfired" "$o"
o=$(PATH="$BINDIR:$PATH" "$BINDIR/amux" color cone notacolor 2>&1 | plain)
has "unknown color" "$o" && ok "an unknown color is refused" || bad "unknown color accepted" "$o"
o=$(PATH="$BINDIR:$PATH" "$BINDIR/amux" start cone --color 'x;y' 2>&1 | plain)
has "invalid --color" "$o" && ok "start refuses an unsafe --color value" || bad "unsafe --color not refused" "$o"
o=$(printf '{"workspace":{"current_dir":"%s"}}' "$SANDBOX/cproj" | AMUX_NAME=cone "$BINDIR/amux-statusline" 2>&1)
has "5;30" "$o" && ok "the status line square uses the session's color" || bad "status line ignored the color" "$o"
printf 'y\n' | run "$BINDIR/amux" rm cone; printf 'y\n' | run "$BINDIR/amux" rm ctwo
o=$(python3 -c 'import json,sys; print(sorted(json.load(open(sys.argv[1]))["sessions"]))' "$CC_HOME/colors.json" 2>&1)
[ "$o" = "[]" ] && ok "rm forgets the color" || bad "color left behind after rm" "$o"

# ── 7d. sandboxes ───────────────────────────────────────────────────────────
sect "7d. Sandboxes (--net-sandbox / --full-sandbox)"
mkdir -p "$SANDBOX/sbx/proj"
o=$("$BINDIR/amux" register sbxa --provider codex --dir "$SANDBOX/sbx/proj" --net-sandbox --full-sandbox 2>&1)
has "mutually exclusive" "$o" && ok "the two sandboxes cannot be combined" || bad "net + full sandbox accepted" "$o"
o=$("$BINDIR/amux" register sbxb --provider codex --dir "$SANDBOX/sbx/proj" --full-access --full-sandbox 2>&1)
has "cannot be combined" "$o" && ok "--full-access cannot be combined with a sandbox" || bad "full access + sandbox accepted" "$o"
o=$(cd "$SANDBOX/sbx/proj" && "$BINDIR/amux-sandbox" launch gemini full . 2>&1)
has "no sandbox for provider" "$o" || has "sandboxes need" "$o" || has "bubblewrap" "$o" && ok "a provider without a sandbox is refused" || bad "gemini sandbox not refused" "$o"
if "$BINDIR/amux-sandbox" check codex full 2>/dev/null; then
  o=$(cd "$SANDBOX/sbx/proj" && CODEX_HOME="$SANDBOX/sbx/codex" "$BINDIR/amux-sandbox" launch codex full . 2>&1)
  has "ARGS -p amux-sbx-full-" "$o" && ok "codex gets a generated permission profile" || bad "no codex profile" "$o"
  f=$(ls "$SANDBOX/sbx/codex"/amux-sbx-full-*.config.toml 2>/dev/null | head -1)
  grep -q 'enabled = false' "$f" 2>/dev/null && grep -q '":workspace_roots" = "write"' "$f" \
    && ok "the full profile has no network and a writable folder" || bad "codex profile wrong" "$(cat "$f" 2>&1 | head -12)"
  mkdir -p "$HOME/.local/bin" "$HOME/.local/share/someapp"
  o=$(cd "$SANDBOX/sbx/proj" && CODEX_HOME="$SANDBOX/sbx/codex" "$BINDIR/amux-sandbox" launch codex net . 2>&1)
  f=$(ls "$SANDBOX/sbx/codex"/amux-sbx-net-*.config.toml 2>/dev/null | head -1)
  { grep -q "\"$HOME/.local/share/someapp\" = \"deny\"" "$f" 2>/dev/null || grep -q "\"$HOME/.local/share\" = \"deny\"" "$f" 2>/dev/null; } \
    && ! grep -q "\"$HOME/.local/bin\" = \"deny\"" "$f" \
    && ok "app data in ~/.local/share is hidden, ~/.local/bin stays readable" || bad "readable home list wrong" "$(grep local "$f" 2>&1 | head -6)"
  o=$(cd "$SANDBOX/sbx/proj" && "$BINDIR/amux-sandbox" launch claude full . 2>&1)
  sf=$(printf '%s\n' "$o" | sed -n 's/^ARGS --settings //p')
  python3 -c 'import json,sys; s=json.load(open(sys.argv[1])); b=s["sandbox"]; assert b["enabled"] and b["failIfUnavailable"] and not b["allowUnsandboxedCommands"] and b["network"]["strictAllowlist"] and s["permissions"]["blockWritesOutsideWorkingDirectories"]' "$sf" 2>/dev/null \
    && ok "claude's full sandbox fails closed and has no network" || bad "claude sandbox settings wrong" "$o"
  o=$(cd "$SANDBOX/sbx/proj" && "$BINDIR/amux-sandbox" launch opencode net . 2>&1)
  has "ARGS --auto" "$o" && { has "PREFIX bwrap" "$o" || has "PREFIX /usr/bin/sandbox-exec" "$o"; } \
    && ok "opencode is wrapped whole for --net-sandbox" || bad "opencode wrapper missing" "$o"
else
  o=$("$BINDIR/amux-sandbox" check codex full 2>&1)
  [ -n "$o" ] && ok "no sandbox support here, and amux-sandbox says why ($o)" || bad "check failed silently"
fi

# ── 7e. sessions by name + the 0.7.3 command-line fixes ───────────────────────
sect "7e. Sessions by name, one row order, option checks"
E="$SANDBOX/e"; mkdir -p "$E/d1" "$E/d2" "$E/shared" "$E/mock"
E=$(cd "$E" && pwd)   # as amux stores a folder (macOS's TMPDIR ends in a slash)
A() { PATH="$E/mock:$BINDIR:$PATH" "$BINDIR/amux" "$@" 2>&1 | plain; }
S="$CC_HOME/sessions"
# Is setting $2 present in session $1's registration? Loaded the way amux loads it;
# the value is never printed.
isset() { ( set +u; CC_DESC= CC_PINNED= CC_ITERM2_SESSION_ID=; . "$S/$1.env" 2>/dev/null; eval "v=\$$2"; [ -n "$v" ] ); }
rownum() { A ls | awk -v n="$1" '{x=$2; sub(/^.*:/,"",x); if (x==n) print $1+0}'; }

# option checks
o=$(A register e1 --provider claude --strict-mcp-config --model opus --dir "$E/d1")
has "flags: --strict-mcp-config --model opus" "$o" && ok "--strict-mcp-config no longer swallows the next option" || bad "--strict-mcp-config" "$o"
o=$(A register e2 --provider claude --model)
has "--model needs a value" "$o" && ! has "unbound variable" "$o" && ok "an option without its value is a message, not a crash" || bad "missing value" "$o"
o=$(A register e2 --provider claude --dir)
has "--dir needs a path" "$o" && ok "--dir without a path is a message" || bad "--dir without a path" "$o"
o=$(A register e2 --provider claude opus)
has "register does not know 'opus'" "$o" && ok "register refuses what it cannot store" || bad "register stray word" "$o"
o=$(A register e2 --provider claude --desc hi)
isset e2 CC_DESC && ok "register stores --desc here too, as -H exec does" || bad "--desc locally" "$o"
A rm e2 >/dev/null 2>&1

# re-register keeps the session
printf 'CC_DESC="from the dashboard"\nCC_PINNED="1"\n' >> "$S/e1.env"
o=$(cd "$E/d2" && A register e1 --model sonnet)
i=$(A info e1)
has "dir:   $E/d1" "$i" && has "folder kept as registered" "$o" && ok "re-register without --dir keeps the folder, and says so" || bad "folder not kept" "$o / $i"
isset e1 CC_DESC && isset e1 CC_PINNED && ok "the dashboard's description and pin survive a re-register" || bad "description or pin lost"
( cd "$E/d2" && A register e1 --pwd >/dev/null )
has "dir:   $E/d2" "$(A info e1)" && ok "--pwd moves the session" || bad "--pwd did not move it" "$(A info e1)"
printf 'CC_ITERM2_SESSION_ID="w0t0p0:ABC"\n' >> "$S/e1.env"
A register e1 --provider codex >/dev/null
isset e1 CC_ITERM2_SESSION_ID && bad "a stale iTerm2 pane id survived a change of agent" || ok "a pane id is dropped when the agent is no longer iterm2"
A register e1 --provider claude --dir "$E/d1" >/dev/null

# ls arguments, info, peek
o=$(A ls --bogus);  has "amux ls: unknown option '--bogus'" "$o" && ok "amux ls refuses an unknown option" || bad "ls --bogus" "$o"
o=$(A ls zz);       has "amux search --sessions zz" "$o" && ok "amux ls <text> points to search --sessions" || bad "ls zz" "$o"
o=$(A ls -c --bare); has "e1" "$o" && ! has " sessions " "$o" && ok "amux ls -c --bare drops the banner" || bad "ls -c --bare" "$o"
printf 'CC_NAME="legacy"\nCC_DIR="%s"\n' "$E/d1" > "$S/legacy.env"
o=$(A info legacy); has "provider: claude" "$o" && ! has "unbound variable" "$o" && ok "amux info reads a registration with no provider line" || bad "info legacy" "$o"
o=$(A peek e1 abc); has "lines is a number" "$o" && ok "amux peek refuses a line count that is not a number" || bad "peek abc" "$o"

# one rename
for n in Zeta alpha x-y x; do A register "$n" --provider codex --dir "$E/shared" >/dev/null; done
want=$(A ls | awk '$1 ~ /^2\*?$/ {x=$2; sub(/^.*:/,"",x); print x}')
o=$(PATH="$E/mock:$BINDIR:$PATH" LC_ALL=C "$BINDIR/amux-rename" -n 2 fresh 2>&1 | plain)
[ -n "$want" ] && has "rename $want " "$o" && ok "amux-rename <row> means the row amux ls shows ($want)" || bad "amux-rename row number" "ls row 2 = $want; $o"
o=$(A rename alpha a.b);  has "invalid new name" "$o" && ok "rename refuses a name register would refuse" || bad "rename a.b" "$o"
printf '{"gemini_session_id":"g1","cc_session_name":"alpha"}' > "$S/alpha.meta.json"
mkdir -p "$CC_HOME/origins" "$CC_HOME/memory" "$CC_HOME/logs"
echo o > "$CC_HOME/origins/alpha"; echo m > "$CC_HOME/memory/alpha.md"; echo l > "$CC_HOME/logs/alpha.log"
o=$(A rename -n alpha gamma9); has "origin, memory, log" "$o" && [ -f "$S/alpha.meta.json" ] && ok "amux rename -n shows the plan and changes nothing" || bad "rename -n" "$o"
o=$(A rename alpha gamma9)
has "renamed alpha" "$o" && [ -f "$S/gamma9.meta.json" ] && [ ! -f "$S/alpha.meta.json" ] && [ -f "$CC_HOME/memory/gamma9.md" ] \
  && [ -f "$CC_HOME/origins/gamma9" ] && [ -f "$CC_HOME/logs/gamma9.log" ] \
  && ok "amux rename moves the registration, state file, origin, memory and log together" || bad "amux rename" "$o"
