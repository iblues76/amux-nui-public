[ "$(mk m-agent)" = "[*]" ] && [ "$(mk m-shell)" = "[~]" ] && [ "$(mk m-dead)" = "[~]" ] && [ "$(mk m-off)" = "[]" ] \
  && ok "amux ls: * for a live agent, ~ for an open shell or a dead pane, blank for stopped" || bad "amux ls marks" "$(mk m-agent) $(mk m-shell) $(mk m-dead) $(mk m-off)"
o=$(COLUMNS=250 A ls -c)
has "● cx:m-agent" "$o" && has "◐ cx:m-shell" "$o" && has "◐ cx:m-dead" "$o" && has "○ cx:m-off" "$o" && has "2 ◐ no agent" "$o" \
